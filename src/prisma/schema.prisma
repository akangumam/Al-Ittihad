datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

// ==================== AUTH MODELS ====================
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  activityLogs  ActivityLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== ACADEMIC MODELS ====================
model Student {
  id               String   @id @default(cuid())
  nis              String   @unique
  nisn             String   @unique
  name             String
  nickname         String?
  grade            String
  class            String
  birthPlace       String?
  birthDate        String
  gender           String   // 'L' or 'P'
  religion         String?
  address          String
  rt               String?
  rw               String?
  kelurahan        String?
  kecamatan        String?
  city             String?
  province         String?
  postalCode       String?
  parentName       String
  fatherName       String?
  motherName       String?
  guardianName     String?
  guardianRelation String?
  phone            String?
  parentPhone      String
  email            String?
  enrollmentDate   String?
  sppStartDate     String?
  previousSchool   String?
  status           String   // 'Aktif', 'Lulus', 'Keluar', 'Cuti'
  photo            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sppPayments      SPPPayment[]

  @@index([nis])
  @@index([grade, class])
  @@index([status])
}

model Class {
  id              String   @id @default(cuid())
  grade           String
  className       String
  capacity        Int
  currentStudents Int
  teacher         String
  academicYear    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([grade, className, academicYear])
  @@index([academicYear])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate String
  endDate   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id         String   @id @default(cuid())
  nip        String   @unique
  nuptk      String
  name       String
  subject    String
  position   String
  gender     String   // 'L' or 'P'
  birthPlace String?
  birthDate  String?
  phone      String
  email      String
  address    String
  education  String?
  status     String   // 'Aktif', 'Cuti', 'Pensiun', 'Keluar'
  photo      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedules  TeachingSchedule[]

  @@index([nip])
  @@index([status])
}

model TeachingSchedule {
  id           String   @id @default(cuid())
  teacherId    String
  teacherName  String
  subject      String
  day          String   // 'Senin', 'Selasa', etc.
  startTime    String
  endTime      String
  grade        String
  class        String
  academicYear String
  room         String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([grade, class])
}

// ==================== FINANCE MODELS ====================
model TransactionCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   // 'Pemasukan' or 'Pengeluaran'
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model BankAccount {
  id            String   @id @default(cuid())
  accountName   String
  accountNumber String
  bankName      String
  accountType   String   // 'Kas' or 'Bank'
  balance       Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  incomes       Income[]
  expenses      Expense[]
  sppPayments   SPPPayment[]
  mutationsFrom CashMutation[] @relation("FromAccount")
  mutationsTo   CashMutation[] @relation("ToAccount")

  @@index([accountType])
}

model Income {
  id            String   @id @default(cuid())
  date          String
  category      String
  description   String
  amount        Float
  account       String
  paymentMethod String
  referenceNo   String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankAccount   BankAccount @relation(fields: [account], references: [id])

  @@index([date])
  @@index([category])
}

model Expense {
  id            String   @id @default(cuid())
  date          String
  category      String
  description   String
  amount        Float
  account       String
  paymentMethod String
  budgetId      String?
  referenceNo   String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankAccount   BankAccount @relation(fields: [account], references: [id])
  budget        Budget?     @relation(fields: [budgetId], references: [id])

  @@index([date])
  @@index([category])
  @@index([budgetId])
}

model CashMutation {
  id          String   @id @default(cuid())
  date        String
  fromAccount String
  toAccount   String
  amount      Float
  description String
  referenceNo String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromBankAccount BankAccount @relation("FromAccount", fields: [fromAccount], references: [id])
  toBankAccount   BankAccount @relation("ToAccount", fields: [toAccount], references: [id])

  @@index([date])
}

// ==================== SPP MODELS ====================
model SPPRate {
  id           String   @id @default(cuid())
  grade        String
  class        String
  amount       Float
  academicYear String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([grade, class, academicYear])
  @@index([academicYear])
}

model SPPPayment {
  id            String   @id @default(cuid())
  studentId     String
  studentName   String
  month         String
  year          String
  amount        Float
  paymentDate   String
  account       String
  paymentMethod String
  receiptNo     String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount @relation(fields: [account], references: [id])

  @@unique([studentId, month, year])
  @@index([studentId])
  @@index([paymentDate])
}

// ==================== BUDGET MODELS ====================
model Budget {
  id          String   @id @default(cuid())
  budgetCode  String   @unique
  name        String
  category    String   // 'Operasional', 'Modal', 'Pemeliharaan', 'Pengembangan'
  amount      Float
  source      String   // 'BOS', 'APBN', 'APBD', 'Donasi', 'Lainnya'
  fiscalYear  String
  status      String   // 'Draft', 'Pending', 'Approved', 'Rejected', 'Active', 'Closed'
  realization Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses    Expense[]

  @@index([fiscalYear])
  @@index([status])
}

// ==================== ACTIVITY LOG MODELS ====================
model ActivityLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  userId       String?
  username     String?
  activityType String
  description  String
  metadata     String?  // JSON stringified
  status       String   // 'success' or 'failed'
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([userId])
  @@index([activityType])
}
