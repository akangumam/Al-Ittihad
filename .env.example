# ========================================
# Al-Ittihad Environment Variables Template
# ========================================
# This is a TEMPLATE file - safe to commit to Git
# Copy this to .env and fill in actual values
# NEVER commit .env with real secrets!

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3000${BASEPATH}
NEXT_PUBLIC_DOCS_URL=https://demos.pixinvent.com/materialize-nextjs-admin-template/documentation

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_BASEPATH=/api/auth
# For development
NEXTAUTH_URL=http://localhost:3000
# For production - replace with your domain
# NEXTAUTH_URL=https://alittihad.sch.id

# Generate a new secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=GENERATE_NEW_SECRET_FOR_PROD

# Google OAuth 2.0 — TIDAK DIGUNAKAN (login dikelola manual oleh admin)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DEVELOPMENT (MySQL - Laragon local)
DATABASE_URL=mysql://root:@localhost:3306/al_ittihad_dev

# PRODUCTION - DomaiNesia
# ⚠️ Jangan pakai "localhost" — DomaiNesia pakai server DB terpisah!
# Gunakan hostname: alezio-db  ATAU  alezio-db.id.rapidplex.com
# DATABASE_URL="mysql://DB_USER:DB_PASSWORD@alezio-db:3306/DB_NAME"

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Use relative URL for API (works with any host)
NEXT_PUBLIC_API_URL=/api

# -----------------------------------------------------------------------------
# Mapbox (Optional - for maps feature)
# -----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Email Service (Resend) — TIDAK DIGUNAKAN
# Login dan reset password dikelola manual oleh admin, tidak perlu email service
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=
APP_NAME=MTs Al-Ittihad

# -----------------------------------------------------------------------------
# SECURITY NOTE
# -----------------------------------------------------------------------------
# ⚠️ IMPORTANT:
# 1. Copy this file to .env
# 2. Fill in actual values (never commit .env!)
# 3. For production:
#    - Generate NEW NEXTAUTH_SECRET
#    - Use PostgreSQL DATABASE_URL
#    - Get NEW RESEND_API_KEY
#    - Use verified domain for EMAIL_FROM
# 4. Store production secrets in:
#    - Vercel: Dashboard → Environment Variables
#    - Railway: Dashboard → Variables
#    - VPS: Environment variables or .env file (chmod 600)
